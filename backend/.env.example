OPENAI_API_KEY=
# Comma-separated JSON list of exact trusted frontend origins.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_knowledge_base
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_GENERATION_NUM_PREDICT=192
OLLAMA_GENERATION_NUM_CTX=4096
OLLAMA_GENERATION_TEMPERATURE=0.2
OLLAMA_GENERATION_TOP_P=0.9
OLLAMA_GENERATION_TOP_K=40
OLLAMA_GENERATION_REPEAT_PENALTY=1.1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
QUERY_STREAMING_ENABLED=true
OPENAI_MODEL=gpt-4.1-mini
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=8
RETRIEVAL_CANDIDATE_LIMIT=50
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2
RETRIEVAL_OVERLAP_THRESHOLD=0.65
RETRIEVAL_SIMILARITY_THRESHOLD=0.85
EMBEDDING_MODEL=nomic-embed-text

# Low-overhead query latency profiling. Enable explicitly per environment.
QUERY_PROFILING_ENABLED=false
QUERY_PROFILING_LOG_LEVEL=INFO
QUERY_PROFILING_INCLUDE_COUNTS=true
QUERY_PROFILING_SLOW_THRESHOLD_MS=30000
QUERY_PROFILING_SERVER_TIMING_ENABLED=false
HYBRID_KEYWORD_WEIGHT=0.4
HYBRID_SEMANTIC_WEIGHT=0.6
SEMANTIC_MIN_SIMILARITY=0.25
SEMANTIC_CANDIDATE_LIMIT=100

# Qdrant semantic vector index. MongoDB remains authoritative.
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks
QDRANT_VECTOR_SIZE=768
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT_SECONDS=10
QDRANT_SEMANTIC_LIMIT=30
QDRANT_BATCH_SIZE=100
QDRANT_SYNC_ON_WRITE=true
# Degrade to local semantic/keyword retrieval when Qdrant is unavailable.
QDRANT_FALLBACK_ENABLED=true

# Authentication is enabled by default. Generate a unique production secret.
AUTH_ENABLED=true
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional, idempotent first-admin bootstrap. Leave both blank to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
